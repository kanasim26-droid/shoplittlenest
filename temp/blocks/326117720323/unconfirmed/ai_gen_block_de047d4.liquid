{% doc %}
  @prompt
    display the products
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-display-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 24px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    box-sizing: border-box;
  }

  .ai-product-display-{{ ai_gen_id }} .ai-product-display__heading {
    margin: 0 0 20px;
    font-size: clamp(22px, 3vw, 32px);
    line-height: 1.2;
    color: {{ block.settings.text_color }};
  }

  .ai-product-display-{{ ai_gen_id }} .ai-product-display__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 20px;
  }

  .ai-product-display-{{ ai_gen_id }} .ai-product-display__card {
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .ai-product-display-{{ ai_gen_id }} .ai-product-display__image-wrap {
    display: block;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: rgba(52, 72, 61, 0.08);
    border-radius: 8px;
  }

  .ai-product-display-{{ ai_gen_id }} .ai-product-display__image-wrap img,
  .ai-product-display-{{ ai_gen_id }} .ai-product-display__image-wrap svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-display-{{ ai_gen_id }} .ai-product-display__details {
    padding-top: 10px;
  }

  .ai-product-display-{{ ai_gen_id }} .ai-product-display__title {
    margin: 0 0 5px;
    font-size: 16px;
    line-height: 1.4;
    color: {{ block.settings.text_color }};
  }

  .ai-product-display-{{ ai_gen_id }} .ai-product-display__price {
    margin: 0;
    font-size: 15px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-display-{{ ai_gen_id }} .ai-product-display__empty {
    margin: 0;
    padding: 20px;
    text-align: center;
    color: {{ block.settings.text_color }};
    border: 1px dashed rgba(52, 72, 61, 0.35);
    border-radius: 8px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-display-{{ ai_gen_id }} {
      padding: 18px;
    }

    .ai-product-display-{{ ai_gen_id }} .ai-product-display__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 14px;
    }
  }
{% endstyle %}

<div class="ai-product-display-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-product-display__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  {% if block.settings.products != blank %}
    <div class="ai-product-display__grid">
      {% for product in block.settings.products %}
        <a class="ai-product-display__card" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
          <span class="ai-product-display__image-wrap">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
            {% else %}
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            {% endif %}
          </span>
          <span class="ai-product-display__details">
            <span class="ai-product-display__title">{{ product.title | escape }}</span>
            <span class="ai-product-display__price">{{ product.price | money }}</span>
          </span>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <p class="ai-product-display__empty">Choose products in the block settings to display them here.</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product display",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured products"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 8
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F7F5EF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#34483D"
    }
  ],
  "presets": [
    {
      "name": "Product display"
    }
  ],
  "tag": null,
  "class": "product-display-block"
}
{% endschema %}